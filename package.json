{
  "name": "Intranet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:frontend": "vue-cli-service build",
    "build:api": "cd api && nest build",
    "build": "npm run build:frontend && npm run build:api",
    "start:api": "cd api && nest start",
    "start": "npm run start:api",
    "serve:frontend": "vue-cli-service serve",
    "serve:backend": "cd api && nest start --watch",
    "serve": "concurrently \"npm run serve:frontend\" \"npm run serve:backend\"",
    "start:prod": "npm run build && cd api && node dist/main.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@tanstack/vue-query": "^4.37.1",
    "axios": "^1.8.2",
    "core-js": "^3.8.3",
    "element-plus": "^2.9.6",
    "moment": "^2.30.1",
    "socket.io-client": "^4.8.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.2.13",
    "vue-router": "^4.5.0",
    "vue3-print-nb": "^0.1.4",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "sass": "^1.86.0",
    "sass-loader": "^16.0.5"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
